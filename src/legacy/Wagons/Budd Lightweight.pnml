/*
 * Budd Lightweights
 */
// TODO update ids

spriteset(spriteset_p_Budd_LW_Coach, "gfx/Budd_Lightweight.png")    { [37, 1,        40, 16, -23, -13] }
spriteset(spriteset_p_Budd_LW_Diner, "gfx/Budd_Lightweight.png")    { [37, 1 + 29*1, 40, 16, -23, -13] }
spriteset(spriteset_p_Budd_LW_Sleeper, "gfx/Budd_Lightweight.png")  { [37, 1 + 29*2, 40, 16, -23, -13] }
spriteset(spriteset_p_Budd_LW_Dome, "gfx/Budd_Lightweight.png")     { [37, 1 + 29*3, 40, 16, -23, -13] }
spriteset(spriteset_p_Budd_LW_Dome_Obs, "gfx/Budd_Lightweight.png") { [37, 1 + 29*4, 40, 16, -23, -13] }
spriteset(spriteset_p_Budd_LW_Obs, "gfx/Budd_Lightweight.png")      { [37, 1 + 29*5, 40, 16, -23, -13] }

spriteset(spriteset_p_Budd_LW_Baggage, "gfx/Budd_Lightweight_Baggage.png")  { tmpl_p_9(1, 1) }
spriteset(spriteset_p_Budd_LW_RPO, "gfx/Budd_Lightweight_Baggage.png")      { tmpl_p_9(1, 28) }

spriteset(spriteset_Budd_LW_Coach, "gfx/Budd_Lightweight.png")    { tmpl_10_1(0, 0) tmpl_10_2(0, 1) }
spriteset(spriteset_Budd_LW_Diner, "gfx/Budd_Lightweight.png")    { tmpl_10_1(1, 0) tmpl_10_2(1, 1) }
spriteset(spriteset_Budd_LW_Sleeper, "gfx/Budd_Lightweight.png")  { tmpl_10_1(2, 0) tmpl_10_2(2, 1) }
spriteset(spriteset_Budd_LW_Dome, "gfx/Budd_Lightweight.png")     { tmpl_10_1(3, 0) tmpl_10_2(3, 1) }
spriteset(spriteset_Budd_LW_Dome_Obs, "gfx/Budd_Lightweight.png") { tmpl_10_1(4, 0) tmpl_10_2(4, 1) }
spriteset(spriteset_Budd_LW_Obs, "gfx/Budd_Lightweight.png")      { tmpl_10_1(5, 0) tmpl_10_2(5, 1) }

spriteset(spriteset_Budd_LW_Baggage, "gfx/Budd_Lightweight_Baggage.png") { tmpl_9_1(0, 0) tmpl_9_2(0, 1) }
spriteset(spriteset_Budd_LW_RPO, "gfx/Budd_Lightweight_Baggage.png")     { tmpl_9_1(0, 1) tmpl_9_2(1, 1) }

switch(FEAT_TRAINS, SELF, sw_Budd_LW_gfx, vehicle_type_id * (position_in_vehid_chain % 2)) {
  item_Budd_LW_Coach:     spriteset_Budd_LW_Coach;
  item_Budd_LW_Diner:     spriteset_Budd_LW_Diner;
  item_Budd_LW_Sleeper:   spriteset_Budd_LW_Sleeper;
  item_Budd_LW_Dome:      spriteset_Budd_LW_Dome;
  item_Budd_LW_Dome_Obs:  spriteset_Budd_LW_Dome_Obs;
  item_Budd_LW_Obs:       spriteset_Budd_LW_Obs;

  item_Budd_LW_Baggage: spriteset_Budd_LW_Baggage;
  item_Budd_LW_RPO: spriteset_Budd_LW_RPO;
  spriteset_empty;
}

item(FEAT_TRAINS, item_Budd_LW_Coach, 748) {
  property {
    name:                         string(STR_Budd_LW_Coach_Name);
    climates_available:           bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
    introduction_date:            date(1937, 1, 1);
    model_life:                   VEHICLE_NEVER_EXPIRES;
    vehicle_life:                 30;
    refittable_cargo_classes:     bitmask(CC_PASSENGERS);
    loading_speed:                14;
    cost_factor:                  147;
    running_cost_factor:          0;
    sprite_id:                    SPRITE_ID_NEW_TRAIN;
    speed:                        110 mph;
    refit_cost:                   0;
    track_type:                   RAIL;
    ai_special_flag:              AI_FLAG_PASSENGER;
    power:                        0;
    cargo_capacity:               25;
    weight:                       65 ton;
    ai_engine_rank:               0;
    tractive_effort_coefficient:  0.3;
    air_drag_coefficient:         0.06;
    visual_effect_and_powered:    visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
  }
  graphics {
    purchase:         spriteset_p_Budd_LW_Coach;
    length:           sw_10_8_length;
    articulated_part: sw_articulate_once;
    default:          sw_Budd_LW_gfx;
  }
}

