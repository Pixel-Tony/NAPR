//--------------------------------------------------------------------------------------------------EMD E9
spriteset(spriteset_p_E9, "gfx/USA_EMD_E9.png") { [4, 97, 87, 12, -15, -8] }

template tmpl_E9(x, y) {
  [x,      y,  8, 24,  -3, -11]
  [x + 9,  y, 22, 20, -14, -10]
  [x + 32, y, 32, 16, -16, -12]
  [x + 65, y, 22, 20,  -8, -11]
}

spriteset(spriteset_E9_BN_white, "gfx/USA_EMD_E9.png")  { tmpl_E9(4, 4)   tmpl_E9(92, 4) }
spriteset(spriteset_E9_BN_red, "gfx/USA_EMD_E9.png")  { tmpl_E9(4, 35) tmpl_E9(92, 35) }
spriteset(spriteset_E9_BN_off, "gfx/USA_EMD_E9.png") { tmpl_E9(4, 66)  tmpl_E9(92, 66) }

switch(FEAT_TRAINS, SELF, sw_E9_graphics2, position_in_vehid_chain_from_end == 0 && vehicle_is_flipped) {
  0: spriteset_E9_BN_red;
  spriteset_E9_BN_off;
}
switch(FEAT_TRAINS, SELF, sw_E9_graphics, position_in_vehid_chain) {
  0: spriteset_E9_BN_white;
  sw_E9_graphics2;
}

item(FEAT_TRAINS, item_E9, 212) {
  property {
    name:                           string(STR_E9_Name);
    climates_available:             bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPICAL);
    introduction_date:              date(1954, 8, 1);
    model_life:                     VEHICLE_NEVER_EXPIRES;
    vehicle_life:                   36;
    reliability_decay:              16;
    refittable_cargo_classes:       bitmask(CC_PASSENGERS);
    non_refittable_cargo_classes:   bitmask();
    loading_speed:                  0;
    cost_factor:                    41;
    running_cost_factor:            141;
    sprite_id:                      SPRITE_ID_NEW_TRAIN;
    speed:                          188 km/h;
    misc_flags:                     bitmask();
    refit_cost:                     0;
    track_type:                     RAIL;
    ai_special_flag:                AI_FLAG_PASSENGER;
    power:                          1790 kW;
    running_cost_base:              RUNNING_COST_DIESEL;
    dual_headed:                    0;
    cargo_capacity:                 0;
    weight:                         143 ton;
    ai_engine_rank:                 0;
    engine_class:                   ENGINE_CLASS_DIESEL;
    extra_power_per_wagon:          0;
    tractive_effort_coefficient:    0.3;
    air_drag_coefficient:           0.06;
    visual_effect_and_powered:      visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);
    extra_weight_per_wagon:         0;
    bitmask_vehicle_info:           0;
  }
  graphics {
    purchase:                       spriteset_p_E9;
    additional_text:                string(STR_E9_Desc);
    length:                         8;
    default:                        sw_E9_graphics;
  }
}
